    { "t": 124, "who": "ai", "text": "右前方の機体と、高度差は200フィート。上昇率は十分です。" },
    { "t": 128, "who": "gpws", "text": "クリア・オブ・コンフリクト。" },
    { "t": 129, "who": "capt", "text": "クリア。1万フィートに戻る。" },
